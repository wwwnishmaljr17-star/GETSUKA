# =========================================================
# GETSUKA FRONTEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and adjust values for your environment.
# Only variables starting with VITE_ are exposed to the client bundle.
# NEVER put backend private secrets into this file!
# =========================================================

# Backend API Base URL
# Development: http://localhost:3001
# Production (same domain / reverse proxy): Leave empty or set to production backend domain
VITE_API_URL=http://localhost:3001

# Public Google OAuth Client ID (Must match the backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Public Razorpay Key ID (Client-side checkout key, starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
