# =========================================================
# GETSUKA BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and replace placeholders with your real values.
# NEVER commit the real .env file into source control.
# =========================================================

# Server Port (Default: 3001)
PORT=3001

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/getsuka
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/getsuka?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/getsuka

# JWT Signing Secret (Minimum 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Allowed Frontend Origins for CORS (Multiple can be set or comma-separated)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Service (Nodemailer Gmail App Password for OTP dispatch)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password

# Google OAuth 2.0 Client ID (Must match the frontend Google Client ID)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary Storage (For product images and user profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Credentials (Test keys for dev, Live keys for prod)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_key

# Initial Administrator Bootstrap (Provisioned once on first deployment if no admin exists)
# Use a strong, unique password (minimum 10 characters). NEVER commit real credentials to Git.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=your_strong_admin_password_min_10_chars
INITIAL_ADMIN_NAME=GETSUKA Administrator

